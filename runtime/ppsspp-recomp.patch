@@ -0,0 +1,74 @@
+// Copyright (c) 2012- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// Official git repository and contact information can be found at
+// https://github.com/hrydgard/ppsspp and http://www.ppsspp.org/.
+
+// Static recompilation support. A game's main module is translated ahead of time to C++
+// (tools/recomp.py) and linked in. At load time the relocated module is hashed and compared
+// against the image the code was generated from; on a match, the interpreter's run loop hands
+// every PC that has a compiled entry to native code, and interprets everything else (HLE stubs,
+// other modules, anything the recompiler missed).
+
+#pragma once
+
+#include "Common/CommonTypes.h"
+
+class MIPSState;
+class PSPModule;
+
+typedef void (*RecompFunc)(MIPSState *mips);
+
+struct RecompEntry {
+	u32 addr;
+	u32 funcAddr;  // Start of the region (function) that owns this entry.
+	RecompFunc func;
+};
+
+struct RecompImage {
+	const char *moduleName;
+	u32 base;        // Address of the first word covered by the entry table.
+	u32 size;        // Bytes covered by the entry table.
+	u32 hashStart;   // Range hashed to validate the loaded module (excludes import stubs).
+	u32 hashEnd;
+	u64 hash;        // FNV-1a 64 over [hashStart, hashEnd).
+	const RecompEntry *entries;
+	u32 numEntries;
+};
+
+// Defined by the generated code. Weak fallback returns null.
+const RecompImage *Recomp_GetImage();
+
+void Recomp_OnModuleLoaded(PSPModule *module, bool isMainModule);
+void Recomp_Shutdown();
+bool Recomp_IsActive();
+
+// Runs guest code until the downcount runs out or the core leaves CORE_RUNNING_CPU.
+// The host must already be in the guest's rounding mode (see ApplyHostRoundingMode).
+void Recomp_RunUntilDowncountZero(MIPSState *mips);
+
+// Helpers for generated code.
+RecompFunc Recomp_Lookup(u32 pc);
+// Calls an import stub inline if it is a plain HLE syscall stub. On return, mips->pc says where to go.
+bool Recomp_TryStub(MIPSState *mips, u32 target);
+// Logs an entry into a compiled function at a PC it has no label for.
+void Recomp_BadEntry(MIPSState *mips, u32 funcAddr);
+// For bisecting translation bugs: PPSSPP_RECOMP_OFF=lo-hi[,lo-hi...] sends the functions starting
+// in those ranges to the interpreter. Checked on entry to every compiled function.
+extern const u8 *g_recompOff;
+inline bool Recomp_IsOff(u32 funcAddr) {
+	return g_recompOff && g_recompOff[(funcAddr - 0x08000000) >> 2];
+}
+// For instructions the generated code leaves to the interpreter.
+void Recomp_Interpret(MIPSState *mips, u32 pc, u32 op);
